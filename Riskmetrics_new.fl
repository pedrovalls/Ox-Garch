// Batch code for G@RCH(1) - Riskmetrics with $\lambda = 0.9401$
module("G@RCH");
package("Garch", "GARCH");
usedata("DADOS_BR.xlsx");
// Define the log returns
algebra
{
	LIBOVC= log(IBOVC_SB);
	DLIBOVC = diff(LIBOVC,1);
}
system
{
    Y = DLIBOVC;
}
CSTS(1,0);
DISTRI(0);
ARMA_ORDERS(0,0);
ARFIMA(0);
GARCH_ORDERS(1,1);
MODEL("RiskMETRICS");
MLE(2);
MaxControl(1000,0,0);
MaxControlEps(0.0001,0.005);
MAXSA(1,2.91038e-10,0.5,20,5,0.1,0.1);
estimate("MaxSA", 2000-01-04, 0, 2022-07-15, 0);
